{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": [
    "scripts/build-web-components.ts",
    "scripts/web-artifacts/verifyWebMaterialization.ts",
    "scripts/web-artifacts/verifyNextWebMaterialization.ts",
    "scripts/validate-example-projects.ts",
    "scripts/validate-expo-candidate.ts"
  ]
}
