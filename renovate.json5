/***
 * Repository configuration
 *
 * Loads the canonical Ankhorage dependency-update policy from its default branch.
 *
 */
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>ankhorage/renovate'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Keep the generated-app Expo baseline aligned with the example manifests.',
      managerFilePatterns: ['/^scripts\\/scaffold-zora-example-app\\.ts$/'],
      matchStrings: ["expo:\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"],
      depNameTemplate: 'expo',
      datasourceTemplate: 'npm',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      description: 'Group the Expo SDK patch with the generated-app baseline projection.',
      matchDatasources: ['npm'],
      matchPackageNames: ['expo'],
      matchUpdateTypes: ['patch'],
      groupName: 'Expo SDK patch baseline',
      groupSlug: 'expo-sdk-patch-baseline',
    },
    {
      description: 'Keep React on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react', 'react-dom'],
      allowedVersions: '19.2.3',
    },
    {
      description: 'Keep React Native on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native'],
      allowedVersions: '0.86.x',
    },
    {
      description: 'Keep Gesture Handler on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-gesture-handler'],
      allowedVersions: '~2.32.0',
    },
    {
      description: 'Keep Reanimated on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-reanimated'],
      allowedVersions: '4.5.1',
    },
    {
      description: 'Keep Safe Area Context on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-safe-area-context'],
      allowedVersions: '~5.7.0',
    },
    {
      description: 'Keep React Native Screens on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-screens'],
      allowedVersions: '~4.26.0',
    },
    {
      description: 'Keep React Native SVG on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-svg'],
      allowedVersions: '15.15.4',
    },
    {
      description: 'Keep Worklets on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-worklets'],
      allowedVersions: '0.10.1',
    },
    {
      description: 'Keep React Native Web on the active Expo 57 runtime baseline.',
      matchDatasources: ['npm'],
      matchPackageNames: ['react-native-web'],
      allowedVersions: '~0.21.0',
    },
  ],
}
