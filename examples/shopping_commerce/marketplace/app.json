{
  "expo": {
    "name": "Marketplace",
    "slug": "marketplace",
    "scheme": "marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/fontawesome",
      "@react-native-vector-icons/fontawesome5",
      "@react-native-vector-icons/fontawesome6",
      "@react-native-vector-icons/ionicons"
    ],
    "android": {
      "package": "com.faebster.marketplace"
    }
  }
}
